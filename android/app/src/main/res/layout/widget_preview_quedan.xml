<?xml version="1.0" encoding="utf-8"?>
<!-- Vista previa del widget en el selector del lanzador (datos de ejemplo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:background="@drawable/widget_fondo" android:padding="14dp">
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Te quedan" android:textSize="12sp" android:textColor="#9EA3AB" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="$ 1.250.000" android:textSize="21sp" android:textColor="#F3F4F6" android:textStyle="bold" android:maxLines="1" />
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center" android:text="+ Gasto"
            android:textSize="14sp" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/widget_pildora" />
    </LinearLayout>
    <View android:layout_width="14dp" android:layout_height="match_parent" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Próximos cobros" android:textSize="11sp" android:textColor="#9EA3AB" android:maxLines="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Netflix" android:textSize="12sp" android:textColor="#F3F4F6" android:maxLines="1" android:layout_weight="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3 d" android:textSize="12sp" android:textColor="#9EA3AB" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Arriendo" android:textSize="12sp" android:textColor="#F3F4F6" android:maxLines="1" android:layout_weight="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mañana" android:textSize="12sp" android:textColor="#F5C451" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Gimnasio" android:textSize="12sp" android:textColor="#F3F4F6" android:maxLines="1" android:layout_weight="1"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12 d" android:textSize="12sp" android:textColor="#9EA3AB" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
