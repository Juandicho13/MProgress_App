<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_trazo_negro"
        android:roundIcon="@mipmap/ic_trazo_negro"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- La pantalla real. El ícono del lanzador lo pone uno de los alias de abajo (Ajustes › Ícono de la app). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".IconTrazoNegro"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_trazo_negro"
            android:roundIcon="@mipmap/ic_trazo_negro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconTrazoBlanco"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_trazo_blanco"
            android:roundIcon="@mipmap/ic_trazo_blanco"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAnilloNegro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_anillo_negro"
            android:roundIcon="@mipmap/ic_anillo_negro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAnilloBlanco"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_anillo_blanco"
            android:roundIcon="@mipmap/ic_anillo_blanco"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconProgresoNegro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_progreso_negro"
            android:roundIcon="@mipmap/ic_progreso_negro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconProgresoBlanco"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_progreso_blanco"
            android:roundIcon="@mipmap/ic_progreso_blanco"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconBarrasNegro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_barras_negro"
            android:roundIcon="@mipmap/ic_barras_negro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconBarrasBlanco"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_barras_blanco"
            android:roundIcon="@mipmap/ic_barras_blanco"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
