<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".MProgressApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_trazo_negro"
        android:roundIcon="@mipmap/ic_trazo_negro"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <!-- La pantalla real. El ícono del lanzador lo pone uno de los alias de abajo (Ajustes › Ícono de la app). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <!-- Enlace mágico del correo (F10): vuelve a la app con ?code= para entrar a la cuenta. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mprogress" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <receiver android:name=".notify.ReminderReceiver" android:exported="false" />
        <service
            android:name=".auto.QuickAddTile"
            android:exported="true"
            android:icon="@drawable/ic_notificacion"
            android:label="Registro rápido"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <receiver android:name=".widgets.NextChargeReceiver" android:exported="true" android:label="Próximo cargo">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_proximo_cargo" />
        </receiver>
        <receiver android:name=".widgets.RemainingReceiver" android:exported="true" android:label="Te quedan">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_te_quedan" />
        </receiver>
        <receiver android:name=".widgets.CalendarReceiver" android:exported="true" android:label="Calendario de cobros">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_calendario" />
        </receiver>
        <receiver android:name=".notify.BootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <activity-alias
            android:name=".IconTrazoNegro"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_trazo_negro"
            android:roundIcon="@mipmap/ic_trazo_negro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconTrazoBlanco"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_trazo_blanco"
            android:roundIcon="@mipmap/ic_trazo_blanco"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAnilloNegro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_anillo_negro"
            android:roundIcon="@mipmap/ic_anillo_negro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconAnilloBlanco"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_anillo_blanco"
            android:roundIcon="@mipmap/ic_anillo_blanco"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconProgresoNegro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_progreso_negro"
            android:roundIcon="@mipmap/ic_progreso_negro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconProgresoBlanco"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_progreso_blanco"
            android:roundIcon="@mipmap/ic_progreso_blanco"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconBarrasNegro"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_barras_negro"
            android:roundIcon="@mipmap/ic_barras_negro"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IconBarrasBlanco"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_barras_blanco"
            android:roundIcon="@mipmap/ic_barras_blanco"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

    </application>

</manifest>
