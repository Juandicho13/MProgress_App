<?xml version="1.0" encoding="utf-8"?>
<!--
    Versión completa: lee notificaciones de Wallet y de los bancos, y los SMS de compra.
    Se instala desde el Mac con Android Studio o ADB (cable o depuración inalámbrica). La versión estándar no trae nada de esto
    porque la protección contra fraude de Google Play Protect bloquea las apps instaladas por archivo que lo piden.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application>
        <service
            android:name=".auto.CaptureListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver android:name=".auto.SmsReceiver" android:exported="true" android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
